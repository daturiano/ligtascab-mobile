{
  "expo": {
    "name": "ligtascab-mobile",
    "slug": "ligtascab-mobile",
    "version": "1.0.0",

    "scheme": "ligtascab-mobile",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "@/src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ligtascab to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },

    "orientation": "portrait",
    "icon": "@/src/assets/icon.png",

    "userInterfaceStyle": "light",

    "splash": {
      "image": "@/src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ligtascab.mobile"
    },
    "android": {
      "package": "com.ligtascab.mobile",
      "adaptiveIcon": {
        "foregroundImage": "@/src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
