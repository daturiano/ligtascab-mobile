{
  "expo": {
    "name": "LigtasCab",
    "slug": "ligtascab-mobile",
    "version": "1.0.0",
    "scheme": "ligtascab-mobile",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ligtascab to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ligtascab.mobile"
    },
    "android": {
      "package": "com.ligtascab.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAyPm7ZCDCn7ke9uv7Fj45agA_0mEt_r2g"
        }
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a9ba5e0-9515-4b0c-b174-2c8b7e022132"
      }
    }
  }
}